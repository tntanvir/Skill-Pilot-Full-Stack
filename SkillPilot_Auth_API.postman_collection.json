							"mode": "raw",
							"raw": "{\n    \"username\": \"johndoe\",\n    \"email\": \"johndoe@example.com\",\n    \"password\": \"SecurePassword123!\",\n    \"confirm_password\": \"SecurePassword123!\",\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"phone_number\": \"+1234567890\",\n    \"address\": \"123 Main Street\",\n    \"role\": \"mentor\",\n    \"bio\": \"Experienced Web Development Mentor.\"\n}"
