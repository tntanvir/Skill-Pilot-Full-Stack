				{
					"name": "4. Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.tokens && jsonData.tokens.access) {",
									"    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
									"    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"login",
								""
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"johndoe@example.com\",\n    \"password\": \"SecurePassword123!\"\n}"
						}
					}
